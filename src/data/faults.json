{
  "actions": [
    { "id": "power-off", "on": "device", "type": "power-off" },
    { "id": "slow-device", "on": "device", "type": "degrade", "roles": ["access-point", "access-switch", "clinic-firewall", "core-switch"] },
    { "id": "tunnels-down", "on": "device", "type": "service-failure", "variant": "tunnel-down", "roles": ["clinic-firewall"], "target": "site-service", "service": "vpn" },
    { "id": "dhcp-staff-full", "on": "device", "type": "service-failure", "variant": "dhcp-exhausted", "roles": ["clinic-firewall"], "target": "site-service", "service": "dhcp", "vlan": 20 },
    { "id": "dhcp-guest-full", "on": "device", "type": "service-failure", "variant": "dhcp-exhausted", "roles": ["clinic-firewall"], "target": "site-service", "service": "dhcp", "vlan": 100 },
    { "id": "dns-stopped", "on": "device", "type": "service-failure", "variant": "dns-stopped", "roles": ["vm-identity"], "target": "provider", "service": "dns-internal" },
    { "id": "cert-expired", "on": "device", "type": "service-failure", "variant": "cert-expired", "roles": ["vm-pacs", "vm-files", "cloud-lb"], "target": "provided-service" },
    { "id": "cut-link", "on": "link", "type": "link-cut", "kinds": ["lan", "wan", "wifi", "storage"] },
    { "id": "slow-link", "on": "link", "type": "degrade", "kinds": ["lan", "wan", "wifi"] },
    { "id": "tunnel-cut", "on": "link", "type": "link-cut", "kinds": ["vpn"] }
  ],

  "testSteps": [
    { "id": "power-led", "layer": "power" },
    { "id": "ups-status", "layer": "power" },
    { "id": "mains-room", "layer": "power" },
    { "id": "breaker", "layer": "power" },
    { "id": "bypass", "layer": "power" },
    { "id": "poe-port", "layer": "power", "command": "show power inline" },
    { "id": "link-led", "layer": "link" },
    { "id": "cable-swap", "layer": "link" },
    { "id": "port-status", "layer": "link", "command": "show interfaces status" },
    { "id": "port-errors", "layer": "link", "command": "show interfaces counters errors" },
    { "id": "ap-led", "layer": "link" },
    { "id": "wifi-client", "layer": "link" },
    { "id": "modem-led", "layer": "link" },
    { "id": "ip-address", "layer": "ip", "command": "ipconfig getifaddr en0" },
    { "id": "dhcp-leases", "layer": "ip" },
    { "id": "rogue-devices", "layer": "ip" },
    { "id": "dns-internal", "layer": "dns", "command": "dig pacs.pfotenwerk.example @10.0.70.11" },
    { "id": "dns-second", "layer": "dns", "command": "dig pacs.pfotenwerk.example @10.0.70.12" },
    { "id": "ping-gw", "layer": "gateway", "command": "ping -c 3 {gateway}" },
    { "id": "ping-device", "layer": "gateway", "command": "ping -c 3 {ip}" },
    { "id": "ping-loss", "layer": "gateway", "command": "ping -c 50 {gateway}" },
    { "id": "wan-status", "layer": "wan" },
    { "id": "ping-provider", "layer": "wan", "command": "ping -c 3 198.51.100.1" },
    { "id": "speed-test", "layer": "wan" },
    { "id": "isp-hotline", "layer": "wan" },
    { "id": "status-page", "layer": "wan" },
    { "id": "second-site", "layer": "wan" },
    { "id": "tunnel-status", "layer": "vpn" },
    { "id": "ping-hq", "layer": "vpn", "command": "ping -c 3 10.0.10.1" },
    { "id": "hq-reachable", "layer": "vpn" },
    { "id": "dashboard-device", "layer": "service" },
    { "id": "firmware-version", "layer": "service" },
    { "id": "reboot-window", "layer": "service" },
    { "id": "terminal-selftest", "layer": "service" },
    { "id": "print-queue", "layer": "service", "command": "lpstat -p" },
    { "id": "mdm-lastseen", "layer": "service" },
    { "id": "phone-registered", "layer": "service" },
    { "id": "vendor-contact", "layer": "service" },
    { "id": "vcenter-events", "layer": "service" },
    { "id": "host-console", "layer": "power" },
    { "id": "vm-console", "layer": "service" },
    { "id": "mlag-status", "layer": "link", "command": "show mlag" },
    { "id": "ha-status", "layer": "service" },
    { "id": "storage-paths", "layer": "link", "command": "esxcli storage core path list" },
    { "id": "array-console", "layer": "service" },
    { "id": "service-port", "layer": "service", "command": "nc -vz {ip} 443" },
    { "id": "service-status", "layer": "service", "command": "systemctl status named" },
    { "id": "cert-date", "layer": "service", "command": "openssl s_client -connect {ip}:443 | openssl x509 -noout -dates" },
    { "id": "browser-warning", "layer": "service" },
    { "id": "monitoring-cert", "layer": "service" }
  ],

  "guides": [
    { "id": "switch-off", "match": { "action": "power-off", "roles": ["access-switch"] }, "tests": ["power-led", "ups-status", "ping-device", "dashboard-device"] },
    { "id": "ap-off", "match": { "action": "power-off", "roles": ["access-point"] }, "tests": ["poe-port", "ap-led", "wifi-client", "dashboard-device"] },
    { "id": "firewall-off", "match": { "action": "power-off", "roles": ["clinic-firewall"] }, "tests": ["power-led", "ups-status", "ping-gw", "dashboard-device"] },
    { "id": "terminal-off", "match": { "action": "power-off", "roles": ["card-terminal"] }, "tests": ["power-led", "link-led", "ip-address", "terminal-selftest"] },
    { "id": "printer-off", "match": { "action": "power-off", "roles": ["receipt-printer", "label-printer", "document-printer"] }, "tests": ["power-led", "link-led", "ping-device", "print-queue"] },
    { "id": "mac-off", "match": { "action": "power-off", "roles": ["reception-mac", "office-mac", "treatment-mac", "admin-mac"] }, "tests": ["power-led", "link-led", "ip-address", "mdm-lastseen"] },
    { "id": "phone-off", "match": { "action": "power-off", "roles": ["voip-phone"] }, "tests": ["poe-port", "link-led", "ip-address", "phone-registered"] },
    { "id": "medical-off", "match": { "action": "power-off", "roles": ["xray-pc", "lab-analyzer", "ultrasound"] }, "tests": ["power-led", "link-led", "ping-device", "vendor-contact"] },
    { "id": "mains-off", "match": { "action": "power-off", "roles": ["mains"] }, "tests": ["mains-room", "breaker", "ups-status"] },
    { "id": "ups-off", "match": { "action": "power-off", "roles": ["ups"] }, "tests": ["ups-status", "breaker", "bypass"] },
    { "id": "host-off", "match": { "action": "power-off", "roles": ["esxi-host"] }, "tests": ["host-console", "vcenter-events", "power-led"] },
    { "id": "core-off", "match": { "action": "power-off", "roles": ["core-switch"] }, "tests": ["power-led", "mlag-status", "ping-device"] },
    { "id": "hqfw-off", "match": { "action": "power-off", "roles": ["hq-firewall"] }, "tests": ["power-led", "ha-status", "tunnel-status"] },
    { "id": "storage-off", "match": { "action": "power-off", "roles": ["storage-controller", "backup-storage"] }, "tests": ["power-led", "storage-paths", "array-console"] },
    { "id": "isp-out", "match": { "action": "power-off", "roles": ["isp", "mobile-network"] }, "tests": ["modem-led", "wan-status", "ping-provider", "isp-hotline"] },
    { "id": "vm-off", "match": { "action": "power-off", "layers": ["server"] }, "tests": ["vcenter-events", "vm-console", "service-port"] },
    { "id": "external-out", "match": { "action": "power-off", "layers": ["external"] }, "tests": ["status-page", "second-site", "wan-status"] },
    { "id": "device-off", "match": { "action": "power-off" }, "tests": ["power-led", "link-led", "ping-device"] },

    { "id": "slow-device", "match": { "action": "slow-device" }, "tests": ["port-errors", "ping-loss", "dashboard-device", "firmware-version", "reboot-window"] },
    { "id": "tunnels-down", "match": { "action": "tunnels-down" }, "tests": ["wan-status", "tunnel-status", "ping-hq", "hq-reachable"] },
    { "id": "dhcp-full", "match": { "action": "dhcp-staff-full" }, "tests": ["ip-address", "dhcp-leases", "rogue-devices"] },
    { "id": "dhcp-guest-full", "match": { "action": "dhcp-guest-full" }, "tests": ["ip-address", "dhcp-leases"] },
    { "id": "dns-stopped", "match": { "action": "dns-stopped" }, "tests": ["dns-internal", "dns-second", "service-status"] },
    { "id": "cert-expired", "match": { "action": "cert-expired" }, "tests": ["browser-warning", "cert-date", "monitoring-cert"] },

    { "id": "wan-cut", "match": { "action": "cut-link", "kinds": ["wan"] }, "tests": ["modem-led", "wan-status", "ping-provider", "isp-hotline"] },
    { "id": "wifi-cut", "match": { "action": "cut-link", "kinds": ["wifi"] }, "tests": ["wifi-client", "ap-led", "dashboard-device"] },
    { "id": "storage-cut", "match": { "action": "cut-link", "kinds": ["storage"] }, "tests": ["link-led", "storage-paths", "cable-swap"] },
    { "id": "lan-cut", "match": { "action": "cut-link" }, "tests": ["link-led", "cable-swap", "port-status"] },
    { "id": "slow-wan", "match": { "action": "slow-link", "kinds": ["wan"] }, "tests": ["ping-loss", "speed-test", "wan-status", "isp-hotline"] },
    { "id": "slow-link", "match": { "action": "slow-link" }, "tests": ["port-errors", "cable-swap", "ping-loss"] },
    { "id": "tunnel-cut", "match": { "action": "tunnel-cut" }, "tests": ["wan-status", "tunnel-status", "ping-hq", "hq-reachable"] }
  ],

  "scenarios": [
